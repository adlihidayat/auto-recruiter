# 1. Google Gemini (CRITICAL) - Powers the core intelligence of all agents
# (You can provide GEMINI_API_KEY1, 2, and 3 to automatically cycle through keys on free tiers)
GEMINI_API_KEY1=your_gemini_api_key_here

# 2. Deepgram (CRITICAL) - Powers the voice agent's Speech-to-Text & Text-to-Speech
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# 3. Tavily (CRITICAL) - Powers the Question Maker agent's web search
TAVILY_API_KEY=your_tavily_api_key_here

# Optional LangSmith Tracing
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT="auto-recruiter"
