# PostgreSQL connection URI (Local Docker via docker-compose)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5433/autorecruiter

# Mailpit SMTP Settings (Local Docker via docker-compose)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@autorecruiter.local

# JWT Signing Secret (Generate a strong random string for production)
SECRET_KEY=super-secret-local-key

# LiveKit Server API Credentials
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
